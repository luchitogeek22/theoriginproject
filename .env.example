# === General ===
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Backend ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Base de datos (sqlite local por defecto; postgres en compose)
DATABASE_URL=sqlite:///./data/origin.db

# Redis opcional (caché + jobs). Vacío = memoria local.
REDIS_URL=

# Almacenamiento: "local" o "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=origin-project
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# === NASA/IPAC IRSA — SPHEREx ===
IRSA_SIA2_URL=https://irsa.ipac.caltech.edu/SIA
IRSA_COLLECTIONS=spherex_dr1,spherex_dr1_deep,spherex_qr3,spherex_qr3_deep
IRSA_TIMEOUT_SECONDS=30
IRSA_MAXREC=500
# Límite de descarga por archivo (MB)
DOWNLOAD_LIMIT_MB=512
# Caché de metadatos SIA2 (segundos)
SIA_CACHE_TTL_SECONDS=3600

# === SIMBAD (resolución de nombres) ===
SIMBAD_TIMEOUT_SECONDS=20

# === Límites ===
RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_JOBS=4

# === Supabase Auth (opcional) ===
# Sin estas variables, la app funciona en modo anónimo honesto (sin login).
# Con ellas, /time-explorer, /journal y /discoveries exigen sesión y los
# writes del backend requieren JWT válido, asociando user_id a los registros.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=
# JWT secret del proyecto (Dashboard > Settings > API). Solo backend, secreto.
SUPABASE_JWT_SECRET=

# === Frontend (NEXT_PUBLIC_*) ===
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
